# Порт API. Фронтенд в dev-режиме проксирует /api сюда (см. frontend/vite.config.ts).
PORT=3001
# Файл базы SQLite. Автозаполнение пустой БД зависит от SEED_DEMO_DATA.
DB_PATH=./data/qadam.db
# В dev обычный и Campus демо-входы включены по умолчанию.
# ALLOW_DEMO_LOGIN=false выключает оба входа и существующие Campus demo-сессии.
# В NODE_ENV=production Campus demo запрещено даже с ALLOW_DEMO_LOGIN=true.
# Обычный seed demo выключен в production по умолчанию, но true явно разрешает его.
# Автозаполнение пустой БД — отдельная настройка: dev=true, production=false.
# Явный SEED_DEMO_DATA=true включает его и в production; не включайте для реальных данных.
# ALLOW_DEMO_LOGIN=false
# SEED_DEMO_DATA=false
# Cookie только по HTTPS: production=true, dev=false по умолчанию.
# Для локальной проверки production через HTTP явно задайте false.
# COOKIE_SECURE=false
# Пилот: цены показаны, все публикации бесплатны. Это дефолт и в production.
# Платёжного провайдера нет; реальных списаний и автопродления нет.
BILLING_MODE=preview
# enforced проверяет месячную квоту/Campus: требующая оплаты публикация
# отклоняется с 402 PAYMENT_REQUIRED, а не оплачивается автоматически.
# Продвижение пока только рассчитывается; включения платной активации нет.
# BILLING_MODE=enforced
# Вузы и их администраторы подключаются доверенными локальными командами
# npm run campus:create -w backend -- ... и npm run campus:admin -w backend -- ...
# Роли реального вуза не назначаются окружением, профессией или демо-входом.
# Campus демо-вход работает только с отдельным «ЕНУ · демо», без прав на реальный ЕНУ.
# Эти команды не включают оплату и не меняют бесплатный пилот BILLING_MODE=preview.
