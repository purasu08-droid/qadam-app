# Порт API; dev-фронтенд проксирует /api сюда.
PORT=3001
# Путь относительно backend/. Сохраняй существующую SQLite при переносе.
DB_PATH=./data/qadam.db
# В dev обычный демо-вход и автозаполнение пустой БД включены по умолчанию.
# Production выключает их по умолчанию; явное true разрешает соответствующую настройку.
# ALLOW_DEMO_LOGIN=false
# SEED_DEMO_DATA=false
# Production cookie только по HTTPS. Для локального HTTP явно задай false.
# COOKIE_SECURE=false
# Все публикации бесплатны. Настроек оплаты, квот и вузовских пакетов нет.
