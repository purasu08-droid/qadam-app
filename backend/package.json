{
  "name": "qadam-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts --reset",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "billing:student": "tsx src/billing-admin.ts student",
    "billing:grant": "tsx src/billing-admin.ts grant",
    "campus:create": "tsx src/campus-admin.ts create",
    "campus:admin": "tsx src/campus-admin.ts admin"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.1",
    "@types/node": "24.0.0",
    "tsx": "4.23.14",
    "typescript": "5.6.3"
  }
}
